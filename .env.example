# ─────────────────────────────────────────────────────────────
# llm-finetune-eval — environment template
# Copy to .env and fill real values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# ── HuggingFace ────────────────────────────────────────────────
HF_TOKEN=
HF_HOME=./.cache/huggingface

# ── Weights & Biases ───────────────────────────────────────────
WANDB_API_KEY=
WANDB_PROJECT=llm-finetune-eval
WANDB_MODE=offline          # offline | online | disabled

# ── MLflow ─────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=./mlruns

# ── DVC remote (fill after `dvc init`) ─────────────────────────
DVC_REMOTE_URL=
DVC_REMOTE_USER=
DVC_REMOTE_PASSWORD=

# ── Model / serving ────────────────────────────────────────────
BASE_MODEL=meta-llama/Llama-3.1-8B-Instruct
ADAPTER_PATH=./artifacts/adapter
VLLM_PORT=8000
GATEWAY_PORT=8080
API_KEY=dev-key-change-me
RATE_LIMIT_PER_MIN=60

# ── Observability ──────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
PROMETHEUS_PORT=9090
LOG_LEVEL=INFO

# ── Eval gate (M6) ─────────────────────────────────────────────
EVAL_GATE_TOLERANCE_PTS=1.0

# ── Runtime ────────────────────────────────────────────────────
SEED=42
