# ── Environment ──────────────────────────────
ENV=dev
LOG_LEVEL=INFO

# ── Storage backend: local | s3 | gdrive ────
STORAGE_BACKEND=local
S3_ENDPOINT=
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Metadata DB: sqlite | postgresql ─────────
METADATA_DB_URL=sqlite:///./data/metadata.sqlite

# ── Hugging Face ─────────────────────────────
HF_TOKEN=
HF_HOME=./.cache/huggingface

# ── Tracking: wandb | mlflow | none ──────────
TRACKER=wandb
WANDB_API_KEY=
WANDB_PROJECT=llm-finetune-eval
MLFLOW_TRACKING_URI=

# ── Eval judge (LLM-as-judge) ────────────────
JUDGE_PROVIDER=openai
OPENAI_API_KEY=
JUDGE_MODEL=gpt-4o-mini

# ── Serving ──────────────────────────────────
SERVING_API_KEY=change-me
SERVING_RATE_LIMIT_PER_MIN=60
SERVING_MAX_TOKENS=512
SERVING_TIMEOUT_S=30
VLLM_BASE_URL=http://localhost:8000

# ── Observability: none | langfuse | otel ────
OBSERVABILITY=none
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Eval gate (M6) ───────────────────────────
EVAL_GATE_TOLERANCE_PTS=1.0
